# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=bhoomi_dev
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Google AI Studio (Gemini) — server-side only, never exposed to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Outbound HTTP identity (Nominatim usage policy). Placeholder contacts like example.com
# are blocked (HTTP 403). In production put your real app URL or contact email here.
HTTP_USER_AGENT=BhoomiAI/0.1 (local development build)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Email
SMTP_FROM=Bhoomi AI <no-reply@bhoomi.local>

# Seed an admin account on first start (optional)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
